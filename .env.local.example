# Backend API URL (articles, auth, etc.)
# For production: set API_URL or NEXT_PUBLIC_API_URL when starting the server.
# The app fetches /api/config at runtime so API_URL is read on the server.
NEXT_PUBLIC_API_URL=http://localhost:5001
# API_URL=http://localhost:5001

# MongoDB Configuration (if needed for frontend)
MONGODB_URI=mongodb://localhost:27017/extrahand-support

# Alternative: Use MongoDB Atlas (cloud)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/extrahand-support?retryWrites=true&w=majority
